generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Status {
  ACTIVE   
  DRAFT    
  DELETED
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  DELETED
}

// ==========================================
// PHÂN HỆ 1: RBAC (ROLE-BASED ACCESS CONTROL)
// ==========================================
model User {
  id           String     @id @default(uuid()) @db.VarChar(36)
  username     String     @unique @db.VarChar(50)
  email        String     @unique @db.VarChar(100)
  phoneNumber  String     @map("phone_number") @db.VarChar(20)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  fullName     String?    @map("full_name") @db.VarChar(100)
  status       String     @default("active") @db.VarChar(20)
  urlPicture   String?    @map("url_picture") @db.VarChar(255)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  // Quan hệ
  userRoles      UserRole[]
  examAttempts   ExamAttempt[]
  userWeaknesses UserWeakness[]
  exams Exam[]
  
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id") @db.VarChar(36)
  roleId String @map("role_id") @db.VarChar(36)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.VarChar(36)
  permissionId String @map("permission_id") @db.VarChar(36)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ==========================================
// PHÂN HỆ 2: NGÂN HÀNG CÂU HỎI (QUESTION BANK)
// ==========================================

model LicenseCategory {
  id          String    @id @default(uuid()) @db.VarChar(36)
  name        String    @unique @db.VarChar(10)
  description String    @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  minAge      Int       @default(18) @map("min_age")
  orderIndex   Int       @default(0) @map("order_index") 

  questionLinks   QuestionLicenseCategory[]
  examMatrix      ExamMatrix[]
  examAttempts    ExamAttempt[]
  exams       Exam[]

  @@index([id])
  @@map("license_categories")
}

model Chapter {
  id          String    @id @default(uuid()) @db.VarChar(36)
  name        String    @db.VarChar(255) @unique
  description String?   @db.Text 
  code        String     @unique
  orderIndex  Int       @default(0) @map("order_index") 
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Quan hệ
  questions      Question[]
  userWeaknesses UserWeakness[]
  examMatrixDetails  ExamMatrixDetail[]
  
  @@map("chapters")
}

model Question {
  id              String    @id @default(uuid()) @db.VarChar(36)
  chapterId       String    @map("chapter_id") @db.VarChar(36)
  content         String    @db.Text
  imageUrl        String?   @map("image_url") @db.VarChar(255)
  difficultyLevel Int       @default(1) @map("difficulty_level") @db.TinyInt
  isCritical      Boolean   @default(false) @map("is_critical")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  status          Status    @map("status")
  indexNumber     Int      @map("index_number")

  chapter        Chapter                   @relation(fields: [chapterId], references: [id])
  answers        Answer[]
  licenseLinks   QuestionLicenseCategory[]
  aiExplanation  AiExplanation?
  attemptDetails AttemptDetail[]
  examQuestions   ExamQuestion[]

  @@index([indexNumber])
  @@index([chapterId])
  @@map("questions")
}

model QuestionLicenseCategory {
  questionId        String @map("question_id") @db.VarChar(36)
  licenseCategoryId String @map("license_category_id") @db.VarChar(36)

  question        Question        @relation(fields: [questionId], references: [id])
  licenseCategory LicenseCategory @relation(fields: [licenseCategoryId], references: [id])

  @@id([questionId, licenseCategoryId])
  @@map("question_license_categories")
}

model Answer {
  id         String    @id @default(uuid()) @db.VarChar(36)
  questionId String    @map("question_id") @db.VarChar(36)
  content    String    @db.Text
  imageUrl   String?   @map("image_url") @db.VarChar(255)
  isCorrect  Boolean   @default(false) @map("is_correct")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  question       Question        @relation(fields: [questionId], references: [id])
  attemptDetails AttemptDetail[]

  @@index([questionId])
  @@map("answers")
}

model QuestionArchive {
  id              String    @id @db.VarChar(36)
  chapterId       String    @map("chapter_id") @db.VarChar(36)
  content         String    @db.Text
  imageUrl        String?   @map("image_url") @db.VarChar(255)
  difficultyLevel Int       @map("difficulty_level") @db.TinyInt
  isCritical      Boolean   @map("is_critical")
  createdAt       DateTime  @map("created_at")
  updatedAt       DateTime  @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  archivedAt      DateTime  @default(now()) @map("archived_at")

  @@map("questions_archive")
}

// ==========================================
// PHÂN HỆ 3: CẤU HÌNH ĐỀ THI (EXAM MATRIX)
// ==========================================

model ExamMatrix {
  id                String       @id @default(uuid()) @db.VarChar(36)
  licenseCategoryId String       @map("license_category_id") @db.VarChar(36)
  name              String       @db.VarChar(100)
  isDefault         Boolean      @default(false) @map("is_default")
  totalQuestions    Int          @map("total_questions")
  passingScore      Int          @map("passing_score")
  durationMinutes   Int          @map("duration_minutes")
  minCriticalQuestions Int       @default(1) @map("min_critical_questions") 
  createdAt         DateTime  @map("created_at")
  updatedAt         DateTime  @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  licenseCategory   LicenseCategory @relation(fields: [licenseCategoryId], references: [id])
  details           ExamMatrixDetail[]
  exams             Exam[]
  @@index([licenseCategoryId])  
  @@map("exam_matrices")
}

model ExamMatrixDetail {
  id            String     @id @default(uuid()) @db.VarChar(36)
  examMatrixId  String     @map("exam_matrix_id") @db.VarChar(36)
  chapterId     String     @map("chapter_id") @db.VarChar(36)
  percentage    Int        @map("percentage")
  examMatrix    ExamMatrix @relation(fields: [examMatrixId], references: [id], onDelete: Cascade)
  chapter       Chapter    @relation(fields: [chapterId], references: [id])

  @@unique([examMatrixId, chapterId])
  @@map("exam_matrix_details")
}

model Exam {
  id                   String         @id @default(uuid()) @db.VarChar(36)
  name                 String         @db.VarChar(100)
  userId               String         @map("user_id") @db.VarChar(36)
  examMatrixId         String?        @map("exam_matrix_id") @db.VarChar(36)
  licenseCategoryId    String         @map("license_category_id") @db.VarChar(36)
    
  totalQuestions       Int            @map("total_questions")
  passingScore         Int            @map("passing_score")
  durationMinutes      Int            @map("duration_minutes")
  minCriticalQuestions Int            @map("min_critical_questions")

  status               ExamStatus     @default(PUBLISHED)
  score                Int            @default(0)
  isPassed             Boolean        @default(false)
  
  startedAt            DateTime       @default(now()) @map("started_at")
  endedAt              DateTime?      @map("ended_at")
  deletedAt            DateTime?      @map("deleted_at")

  user                 User            @relation(fields: [userId], references: [id])
  examMatrix           ExamMatrix?      @relation(fields: [examMatrixId], references: [id])
  licenseCategory      LicenseCategory @relation(fields: [licenseCategoryId], references: [id]) 
  questions            ExamQuestion[]
  @@index([userId, status])
  @@map("exams")
}

model ExamQuestion {
  examId        String   @map("exam_id") @db.VarChar(36)
  questionId    String   @map("question_id") @db.VarChar(36)

  correctAnswer Int      @map("correct_answer") 
  isCritical    Boolean  @default(false) @map("is_critical") 
  indexNumber   Int      @map("index_number")

  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question      Question @relation(fields: [questionId], references: [id])

  @@index([indexNumber])
  @@id([examId, questionId])
  @@map("exam_questions")
}


// ==========================================
// PHÂN HỆ 4: LỊCH SỬ THI (EXAM EXECUTION)
// ==========================================

model ExamAttempt {
  id                String    @id @default(uuid()) @db.VarChar(36)
  userId            String    @map("user_id") @db.VarChar(36)
  licenseCategoryId String    @map("license_category_id") @db.VarChar(36)
  startTime         DateTime  @default(now()) @map("start_time")
  endTime           DateTime? @map("end_time")
  totalCorrect      Int       @default(0) @map("total_correct")
  isPassed          Boolean   @default(false) @map("is_passed")
  failedByCritical  Boolean   @default(false) @map("failed_by_critical")

  user            User            @relation(fields: [userId], references: [id])
  licenseCategory LicenseCategory @relation(fields: [licenseCategoryId], references: [id])
  details         AttemptDetail[]

  @@index([userId])
  @@map("exam_attempts")
}

model AttemptDetail {
  id               String  @id @default(uuid()) @db.VarChar(36)
  attemptId        String  @map("attempt_id") @db.VarChar(36)
  questionId       String  @map("question_id") @db.VarChar(36)
  selectedAnswerId String? @map("selected_answer_id") @db.VarChar(36)
  isCorrect        Boolean @default(false) @map("is_correct")

  attempt        ExamAttempt @relation(fields: [attemptId], references: [id])
  question       Question    @relation(fields: [questionId], references: [id])
  selectedAnswer Answer?     @relation(fields: [selectedAnswerId], references: [id])

  @@index([attemptId])
  @@map("attempt_details")
}

// ==========================================
// PHÂN HỆ 5: TRÍ TUỆ NHÂN TẠO (AI & ANALYTICS)
// ==========================================

model AiExplanation {
  id               String   @id @default(uuid()) @db.VarChar(36)
  questionId       String   @unique @map("question_id") @db.VarChar(36)
  explanationText  String   @map("explanation_text") @db.Text
  promptTokens     Int      @map("prompt_tokens")
  completionTokens Int      @map("completion_tokens")
  createdAt        DateTime @default(now()) @map("created_at")

  question Question @relation(fields: [questionId], references: [id])

  @@map("ai_explanations")
}

model UserWeakness {
  id             String   @id @default(uuid()) @db.VarChar(36)
  userId         String   @map("user_id") @db.VarChar(36)
  chapterId      String   @map("chapter_id") @db.VarChar(36)
  errorRate      Float    @map("error_rate") @db.Float
  lastAnalyzedAt DateTime @default(now()) @map("last_analyzed_at")

  user    User    @relation(fields: [userId], references: [id])
  chapter Chapter @relation(fields: [chapterId], references: [id])

  @@index([userId])
  @@map("user_weaknesses")
}

model ImportJob {
  id                String   @id @default(uuid())
  fileName          String   @map("file_name")
  totalSize         Int      @map("total_size")
  totalChunks       Int      @map("total_chunks") // Chính là expectedChunks
  chunkSizeLimit    Int      @map("chunk_size_limit") // Giới hạn mỗi mảnh
  status            String
  resultData        Json?    @map("result_data")
  expiresAt         DateTime @map("expires_at") // Thời gian hết hạn folder /temp/
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("import_jobs")
}