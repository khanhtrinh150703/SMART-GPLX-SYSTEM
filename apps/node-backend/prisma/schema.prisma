generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Status {
  ACTIVE   
  DRAFT    
  DELETED
  ARCHIVED
}


// ==========================================
// PHÂN HỆ 1: RBAC (ROLE-BASED ACCESS CONTROL)
// ==========================================
model User {
  id           String     @id @default(uuid()) @db.VarChar(36)
  username     String     @unique @db.VarChar(50)
  email        String     @unique @db.VarChar(100)
  phoneNumber  String     @map("phone_number") @db.VarChar(20)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  fullName     String?    @map("full_name") @db.VarChar(100)
  status       Status     @default(ACTIVE)
  urlPicture   String?    @map("url_picture") @db.VarChar(255)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  // Quan hệ
  userRoles      UserRole[]
  exams Exam[]
  statistics  UserStatistics?
  examHistory ExamHistory[]
  topicStatistics UserTopicStatistics[]
  questionProgress UserQuestionProgress[]
  @@index([deletedAt])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId String @map("user_id") @db.VarChar(36)
  roleId String @map("role_id") @db.VarChar(36)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.VarChar(36)
  permissionId String @map("permission_id") @db.VarChar(36)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ==========================================
// PHÂN HỆ 2: NGÂN HÀNG CÂU HỎI (QUESTION BANK)
// ==========================================

model LicenseCategory {
  id          String    @id @default(uuid()) @db.VarChar(36)
  name        String    @unique @db.VarChar(10)
  description String    @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  minAge      Int       @default(18) @map("min_age")
  orderIndex   Int      @default(0) @map("order_index") 

  questionLinks   QuestionLicenseCategory[]
  examMatrix      ExamMatrix[]
  exams       Exam[]

  @@index([id])
  @@map("license_categories")
}

model Chapter {
  id          String    @id @default(uuid()) @db.VarChar(36)
  name        String    @db.VarChar(255) @unique
  description String?   @db.Text 
  code        String    @unique @db.VarChar(36)
  orderIndex  Int       @default(0) @map("order_index") 
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Quan hệ
  questions      Question[]
  examMatrixDetails  ExamMatrixDetail[]
  userProgress UserQuestionProgress[]
  @@map("chapters")
}

model Question {
  id              String    @id @default(uuid()) @db.VarChar(36)
  chapterId       String    @map("chapter_id") @db.VarChar(36)
  content         String    @db.Text
  imageUrl        String?   @map("image_url") @db.VarChar(255)
  difficultyLevel Int       @default(1) @map("difficulty_level") @db.TinyInt
  isCritical      Boolean   @default(false) @map("is_critical")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  status          Status    @map("status")
  indexNumber     Int       @map("index_number")

  chapter         Chapter   @relation(fields: [chapterId], references: [id])
  answers         Answer[]
  licenseLinks    QuestionLicenseCategory[]
  aiExplanation   AiExplanation?
  examQuestions   ExamQuestion[]
  statistics      QuestionStatistics?
  userProgress    UserQuestionProgress[]

  @@index([indexNumber])
  @@index([chapterId])
  @@map("questions")
}

model QuestionLicenseCategory {
  questionId        String @map("question_id") @db.VarChar(36)
  licenseCategoryId String @map("license_category_id") @db.VarChar(36)

  question        Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  licenseCategory LicenseCategory @relation(fields: [licenseCategoryId], references: [id])

  @@id([questionId, licenseCategoryId])
  @@map("question_license_categories")
}

model Answer {
  id         String    @id @default(uuid()) @db.VarChar(36)
  questionId String    @map("question_id") @db.VarChar(36)
  content    String    @db.Text
  imageUrl   String?   @map("image_url") @db.VarChar(255)
  isCorrect  Boolean   @default(false) @map("is_correct")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("answers")
}

// ==========================================
// PHÂN HỆ 3: CẤU HÌNH ĐỀ THI (EXAM MATRIX)
// ==========================================

model ExamMatrix {
  id                   String            @id @default(uuid()) @db.VarChar(36)
  licenseCategoryId    String            @map("license_category_id") @db.VarChar(36)
  name                 String            @unique @db.VarChar(100)
  isDefault            Boolean           @default(false) @map("is_default")
  isChapter            Boolean           @default(false) @map("is_chapter") 
  totalQuestions       Int               @map("total_questions")
  passingScore         Int               @map("passing_score")
  durationMinutes      Int               @map("duration_minutes")
  minCriticalQuestions Int               @default(1) @map("min_critical_questions") 
  createdAt            DateTime          @map("created_at")
  updatedAt            DateTime          @map("updated_at")
  deletedAt            DateTime?         @map("deleted_at")

  licenseCategory      LicenseCategory   @relation(fields: [licenseCategoryId], references: [id])
  details              ExamMatrixDetail[]
  exams                Exam[]
  @@index([licenseCategoryId])  
  @@map("exam_matrices")
}

model ExamMatrixDetail {
  id            String     @id @default(uuid()) @db.VarChar(36)
  examMatrixId  String     @map("exam_matrix_id") @db.VarChar(36)
  chapterId     String     @map("chapter_id") @db.VarChar(36)
  percentage    Int        @map("percentage")
  examMatrix    ExamMatrix @relation(fields: [examMatrixId], references: [id], onDelete: Cascade)
  chapter       Chapter    @relation(fields: [chapterId], references: [id])

  @@unique([examMatrixId, chapterId])
  @@map("exam_matrix_details")
}

model Exam {
  id                   String          @id @default(uuid()) @db.VarChar(36)
  name                 String          @unique @db.VarChar(100) 
  userId               String          @map("user_id") @db.VarChar(36)
  examMatrixId         String?         @map("exam_matrix_id") @db.VarChar(36)
  licenseCategoryId    String          @map("license_category_id") @db.VarChar(36)
  isChapter            Boolean         @default(false) @map("is_chapter") 
    
  totalQuestions       Int             @map("total_questions")
  passingScore         Int             @map("passing_score")
  durationMinutes      Int             @map("duration_minutes")
  minCriticalQuestions Int             @map("min_critical_questions")
  isEdited             Boolean         @default(false) @map("is_edited")
  
  status               Status          @default(ACTIVE)
  score                Int             @default(0)
  isPassed             Boolean         @default(false)
  
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  startedAt            DateTime        @default(now()) @map("started_at")
  endedAt              DateTime?       @map("ended_at")
  deletedAt            DateTime?       @map("deleted_at")

  user                 User            @relation(fields: [userId], references: [id])
  examMatrix           ExamMatrix?     @relation(fields: [examMatrixId], references: [id])
  licenseCategory      LicenseCategory @relation(fields: [licenseCategoryId], references: [id]) 
  questions            ExamQuestion[]
  @@index([userId, status])
  @@map("exams")
}

model ExamQuestion {
  examId        String   @map("exam_id") @db.VarChar(36)
  questionId    String   @map("question_id") @db.VarChar(36)

  correctAnswer Int      @map("correct_answer") 
  isCritical    Boolean  @default(false) @map("is_critical") 
  indexNumber   Int      @map("index_number")

  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  question      Question @relation(fields: [questionId], references: [id])

  @@index([indexNumber])
  @@id([examId, questionId])
  @@map("exam_questions")
}

model UserExamRank {
  id                String   @id @default(uuid())
  
  userId            String   @map("user_id")
  examId            String   @map("exam_id") 
  
  bestScore         Int      @default(0) @map("best_score")
  fastestSeconds    Int      @default(0) @map("fastest_seconds")
  
  lastAttemptId     String?  @map("last_attempt_id")
  
  licenseCategoryId String   @map("license_category_id")

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([userId, examId], name: "user_exam_unique_key")

  @@index([examId, bestScore(sort: Desc), fastestSeconds(sort: Asc)])
  @@index([licenseCategoryId])
  
  @@map("user_exam_rank") // Tên bảng trong DB
}

// ---------------------------------------------------------
// MODULE: Exam-Mgmt / Statistics
// ---------------------------------------------------------

model UserStatistics {
  // --- IDENTIFICATION (Định danh) ---
  userId                 String                @id @map("user_id")
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- EXAM OVERVIEW (Tổng quan bài thi) ---
  totalExams             Int                   @default(0) @map("total_exams")
  passedExams            Int                   @default(0) @map("passed_exams")
  failedExams            Int                   @default(0) @map("failed_exams")
  failedByCritical       Int                   @default(0) @map("failed_by_critical") 

  // --- ACCURACY & QUESTIONS (Câu hỏi & Độ chính xác) ---
  totalQuestionsAnswered Int                   @default(0) @map("total_questions_answered")
  totalCorrectAnswers    Int                   @default(0) @map("total_correct_answers")
  totalWrongAnswers      Int                   @default(0) @map("total_wrong_answers")
  totalUnanswered        Int                   @default(0) @map("total_unanswered")

  // --- SCORES & PERCENTAGES (Điểm số & Tỷ lệ) ---
  averageScore           Float                 @default(0) @map("average_score") 
  highScore              Int                   @default(0) @map("high_score")
  lowScore               Int                   @default(100) @map("low_score")

  // --- DURATION METRICS (Số liệu thời gian - Tính bằng giây) ---
  averageDuration        Int                   @default(0) @map("average_duration")
  fastestDuration        Int                   @default(999999) @map("fastest_duration")
  slowestDuration        Int                   @default(0) @map("slowest_duration")

  // --- PERFORMANCE & RANKING (Phong độ & Thứ hạng) ---
  currentStreak          Int                   @default(0) @map("current_streak")
  maxStreak              Int                   @default(0) @map("max_streak")
  currentRank            String?               @map("current_rank") // Ví dụ: "Tay lái lụa", "Học viên ưu tú"

  // --- RECORD DETAILS (Thông tin chi tiết kỷ lục) ---
  highScoreExamId        String?               @map("high_score_exam_id")
  highScoreExamName      String?               @map("high_score_exam_name")
  lowScoreExamId         String?               @map("low_score_exam_id")
  lowScoreExamName       String?               @map("low_score_exam_name")
  fastestExamId          String?               @map("fastest_exam_id")
  fastestExamName        String?               @map("fastest_exam_name")

  // --- TIMESTAMPS (Dấu thời gian) ---
  lastExamAt             DateTime              @default(now()) @map("last_exam_at")
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")
  deletedAt              DateTime?             @map("deleted_at")

  // --- RELATIONS (Quan hệ) ---
  topicStatistics        UserTopicStatistics[]

  @@map("user_statistics")
}

model UserTopicStatistics {
  id             String         @id @default(uuid())
  userId         String         @map("user_id")
  topicId        String         @map("topic_id")
  topicName      String         @map("topic_name")

  // --- QUESTION METRICS ---
  totalQuestions Int            @default(0) @map("total_questions")
  correctAnswers Int            @default(0) @map("correct_answers")
  wrongAnswers   Int            @default(0) @map("wrong_answers")
  unanswered     Int            @default(0) @map("unanswered") // Số câu bỏ qua
  questionsAttempted Int        @default(0) @map("questions_attempted")

  // --- PERCENTAGE METRICS ---
  accuracyRate   Float          @default(0) @map("accuracy_rate") // Tỷ lệ đúng (%)
  errorRate      Float          @default(0) @map("error_rate")    // Tỷ lệ sai (%)

  // --- TIME METRICS (Bổ sung bộ đôi này) ---
  totalDurationSum Float        @default(0) @map("total_duration_sum") 
  averageDuration  Float        @default(0) @map("average_duration")

  // --- TIMESTAMPS ---
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  // --- RELATIONS ---
  statistics     UserStatistics? @relation(fields: [userId], references: [userId], onDelete: Cascade, map: "uts_to_statistics_fkey")
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade, map: "uts_to_user_fkey")

  @@unique([userId, topicId])
  @@map("user_topic_statistics")
}

model QuestionStatistics {
  questionId     String   @id @map("question_id")
  
  // --- ATTEMPT METRICS (Số lượt tương tác) ---
  totalAttempts  Int      @default(0) @map("total_attempts")
  correctCount   Int      @default(0) @map("correct_count")
  wrongCount     Int      @default(0) @map("wrong_count")
  unansweredCount Int     @default(0) @map("unanswered_count") 

  // --- ANALYTICS (Tỷ lệ phân tích) ---
  accuracyRate   Float    @default(0) @map("accuracy_rate") 
  errorRate      Float    @default(0) @map("error_rate")    
  
  // --- TIME METRICS (Bổ sung ở đây) ---
  totalDurationSum Float   @default(0) @map("total_duration_sum") 
  averageDuration  Float   @default(0) @map("average_duration")

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([errorRate])
  @@index([accuracyRate]) 
  @@map("question_statistics")
}

model UserQuestionProgress {
  userId      String    @map("user_id") @db.VarChar(36)
  questionId  String    @map("question_id") @db.VarChar(36)
  // Đổi topicId thành chapterId cho đồng bộ với model Question của bạn
  chapterId   String    @map("chapter_id") @db.VarChar(36)
  
  isPassed    Boolean   @default(false) @map("is_passed")
  wrongCount  Int       @default(0) @map("wrong_count") @db.Int
  timeSpent   Float     @default(0) @map("time_spent")
  
  createdAt   DateTime  @default(now()) @map("created_at")
  lastAttemptAt DateTime @updatedAt @map("last_attempt_at")

  // --- RELATIONS ---
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question    Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  chapter     Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@id([userId, questionId])
  @@index([userId, chapterId]) 
  @@map("user_question_progress")
}

// ---------------------------------------------------------
// MODULE: Exam-Mgmt / History
// ---------------------------------------------------------
model ExamHistory {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  licenseCategoryId String  @map("license_category_id") // A1, A2, B2...
  licenseCategoryName String @map("license_category_name") 
  examName         String @map("exam_name") 

  score            Int      @map("score")
  totalQuestions   Int      @map("total_questions")
  isPassed         Boolean  @map("is_passed")
  duration         Int      @map("duration") 
  
  snapshotId       String   @unique @map("snapshot_id")

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  deletedAt        DateTime?      @map("deleted_at")

  @@index([userId])
  @@index([createdAt])
  @@map("exam_histories")
}

// ==========================================
// PHÂN HỆ 5: TRÍ TUỆ NHÂN TẠO (AI & ANALYTICS)
// ==========================================

model AiExplanation {
  id               String   @id @default(uuid()) @db.VarChar(36)
  questionId       String   @unique @map("question_id") @db.VarChar(36)
  explanationText  String   @map("explanation_text") @db.Text
  promptTokens     Int      @map("prompt_tokens")
  completionTokens Int      @map("completion_tokens")
  createdAt        DateTime @default(now()) @map("created_at")

  question Question @relation(fields: [questionId], references: [id])

  @@map("ai_explanations")
}

model ImportJob {
  id                String   @id @default(uuid())
  fileName          String   @map("file_name")
  totalSize         Int      @map("total_size")
  totalChunks       Int      @map("total_chunks") // Chính là expectedChunks
  chunkSizeLimit    Int      @map("chunk_size_limit") // Giới hạn mỗi mảnh
  status            String
  resultData        Json?    @map("result_data")
  expiresAt         DateTime @map("expires_at") // Thời gian hết hạn folder /temp/
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("import_jobs")
}