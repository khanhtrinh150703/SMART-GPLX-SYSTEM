{
  "dependencies": {
    "awilix": "^13.0.3",
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "nodemailer": "^8.0.3",
    "redis": "^5.11.0",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "winston-loki": "^6.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@prisma/client": "^6.19.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^7.0.11",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "husky": "^8.0.0",
    "jest": "^30.3.0",
    "prisma": "^6.19.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript-eslint": "^8.57.1"
  },
  "scripts": {
    "dev": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint . --ext .ts",
    "test": "npm run db:push:test && npm run db:seed:test && npx dotenv -e .env.local -- jest tests/integration/main.test.ts --runInBand --verbose",
    "testcicd": "npm run db:push:cicd && npm run db:seed:cicd && npx dotenv -e .env.test -- jest tests/integration/main.test.ts --runInBand --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:push": "prisma db push",
    "db:push:test": "dotenv -e .env.local -- prisma db push",
    "db:push:cicd": "dotenv -e .env.test -- prisma db push",
    "db:pull": "prisma db pull",
    "db:pull:test": "dotenv -e .env.local -- prisma db pull",
    "db:gen": "prisma generate",
    "db:seed": "prisma db seed",
    "db:seed:test": "dotenv -e .env.local -- prisma db seed",
    "db:seed:cicd": "dotenv -e .env.test -- prisma db seed"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}