{
  "name": "node-backend",
  "dependencies": {
    "@types/multer": "^2.1.0",
    "awilix": "^13.0.3",
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "framer-motion": "^12.38.0",
    "glob": "^13.0.6",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.3",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "typescript": "^5.9.3",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "winston-loki": "^6.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@prisma/client": "^6.4.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^7.0.11",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "husky": "^8.0.0",
    "jest": "^30.3.0",
    "prisma": "6.4.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript-eslint": "^8.57.1"
  },
  "scripts": {
    "dev": "npm run db:push && npm run db:seed && ts-node-dev -r tsconfig-paths/register --respawn --inspect=9229 src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "lint": "eslint .",
    "test": "npm run db:push:test &&  npm run db:seed:test && npx dotenv -e .env.local -- jest tests/integration/main.test.ts --runInBand --verbose --forceExit",
    "testcicd": "npm run db:push:cicd && npm run db:seed:cicd && npx dotenv -e .env.test -- jest tests/integration/main.test.ts --runInBand --verbose --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:push": "prisma db push --accept-data-loss",
    "db:format": "prisma format",
    "db:push:test": "dotenv -e .env.local -- prisma db push --accept-data-loss",
    "db:push:cicd": "dotenv -e .env.test -- prisma db push --accept-data-loss",
    "db:pull": "prisma db pull",
    "db:pull:test": "dotenv -e .env.local -- prisma db pull",
    "db:gen": "npx prisma generate",
    "db:seed": "dotenv -e .env -- npx tsx -r tsconfig-paths/register prisma/seed.main.ts",
    "db:seed:test": "dotenv -e .env.local -- npx tsx -r tsconfig-paths/register prisma/seed.test.ts",
    "db:seed:cicd": "dotenv -e .env.test -- npx tsx -r tsconfig-paths/register prisma/seed.test.ts",
    "db:see": "npx prisma studio",
    "db:reset": "prisma migrate reset --force && redis-cli flushall",
    "type-check": "tsc --noEmit"
  },
  "prisma": {
    "seed": "npx tsx -r tsconfig-paths/register prisma/seed.main.ts"
  }
}