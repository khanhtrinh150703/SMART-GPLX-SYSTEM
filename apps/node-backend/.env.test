# ==============================================================================
# HỆ THỐNG SMART-GPLX - CẤU HÌNH PRODUCTION (DOCKER COMPOSE)
# ==============================================================================

NODE_ENV=production
PORT=5000
HOST=0.0.0.0
APP_URL='http://localhost:5000'

# ------------------------------------------------------------------------------
# 1. DATABASES & CACHE & MONITORING (Đã chuyển sang Service Name của Docker)
# ------------------------------------------------------------------------------
# MySQL (Trỏ về service mysql-db, thêm password)
DATABASE_URL="mysql://root:password@127.0.0.1:3306/smart_gplx_db?timezone=+07:00"

# MongoDB (Trỏ về service mongodb, thêm user/password)
MONGO_URL="mongodb://root:password@127.0.0.1:27017/smart_gplx_db?authSource=admin"

MONGO_DB_NAME="smart_gplx_db"

# Redis (Trỏ về service redis-cache)
REDIS_URL="redis://:root@127.0.0.1:6379"

# Grafana Loki (Trỏ về service loki)
LOKI_HOST="http://127.0.0.1:3100"

# ------------------------------------------------------------------------------
# 2. CẤU HÌNH SECURITY & JWT AUTHENTICATION
# ------------------------------------------------------------------------------
# Access Token: 256-bit Key (Hex)
JWT_ACCESS_SECRET=Chon_Mot_Chuoi_That_Dai_Và_Kho_Doan_123
JWT_ACCESS_EXPIRES_IN=15m
JWT_ACCESS_TTL=900

# Refresh Token: 512-bit Key (Base64)
JWT_REFRESH_SECRET=Chuoi_Nay_Con_Phai_Kho_Doan_Hon_Nua_456
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_TTL=604800

# Security Lockout
LOCK_TIME=60
PENDING_TTL=600

# ------------------------------------------------------------------------------
# 3. CẤU HÌNH OTP
# ------------------------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_TTL=300

# ------------------------------------------------------------------------------
# 4. CẤU HÌNH BACKGROUND QUEUE (BullMQ) & API
# ------------------------------------------------------------------------------
QUEUE_CONCURRENCY=5
API_PREFIX=/api
API_VERSION=v1

# ------------------------------------------------------------------------------
# 5. CẤU HÌNH STORAGE & UPLOAD 
# ------------------------------------------------------------------------------
TEMP_STORAGE_PATH=storage/temp
UPLOAD_STORAGE_PATH=storage/uploads
UPLOAD_DIR=public/uploads
STATIC_PREFIX=uploads

# ------------------------------------------------------------------------------
# 6. CẤU HÌNH IMPORT DATA
# ------------------------------------------------------------------------------
# Giới hạn kích thước mảnh import (Mặc định 10MB = 10485760 bytes)
IMPORT_CHUNK_SIZE_LIMIT=10485760
# Thời gian sống của một phiên import (Giờ)
IMPORT_SESSION_EXPIRY_HOURS=24

# ------------------------------------------------------------------------------
# 7. CẤU HÌNH PHÂN TRANG (PAGINATION)
# ------------------------------------------------------------------------------
PAGINATION_DEFAULT_PAGE=1
PAGINATION_DEFAULT_LIMIT=10
PAGINATION_MAX_LIMIT=100

# ------------------------------------------------------------------------------
# 8. CẤU HÌNH CỔNG MAIL HỆ THỐNG
# ------------------------------------------------------------------------------
EMAIL_USER=gplx@dividesk.com
EMAIL_PASS=rhrkeoshkiuehtej