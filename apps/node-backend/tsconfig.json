{
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "./",
        "target": "es2022",
        "module": "commonjs",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "sourceMap": true, 
        "inlineSourceMap": false, 
        "declaration": true,
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src/**/*", "tests/**/*", "../../exam-matrix.record.ts"]
}