# =========================================================
# STAGE 1: Builder - Cài đặt thư viện và biên dịch mã nguồn
# =========================================================
FROM node:20-alpine AS builder
WORKDIR /app

# 1. Copy trước các file package và tsconfig để tận dụng Docker cache layer
COPY package*.json ./
COPY apps/node-backend/package*.json ./apps/node-backend/
COPY tsconfig*.json ./
COPY apps/node-backend/tsconfig*.json ./apps/node-backend/

# Tạo thư mục rỗng để NPM nhận diện đúng cấu trúc Workspace con
RUN mkdir -p apps/node-backend

# 2. Cài đặt toàn bộ thư viện dựa trên file lock tổng.
# Cờ --ignore-scripts để chặn script postinstall chạy lệnh Prisma generate lúc này
# (vì chưa copy file schema.prisma vào, nếu không chặn sẽ bị báo lỗi thiếu file và sập build).
RUN npm ci --ignore-scripts

# 3. Copy toàn bộ mã nguồn thực tế vào container
COPY . .

# 4. Chạy tạo Prisma Client khi đã có đầy đủ file schema.prisma
RUN npm run db:gen -w node-backend

# 5. Biên dịch toàn bộ code TypeScript của Backend sang JavaScript (nằm trong thư mục dist)
RUN cd apps/node-backend && npm run build

# 6. Sửa lại các đường dẫn alias (dạng @/*) trong thư mục dist thành đường dẫn đúng sau khi build
RUN npx --yes tsc-alias -p apps/node-backend/tsconfig.json

# 7. Xóa sạch các thư viện phát triển (devDependencies), chỉ giữ lại thư viện chạy Production
RUN npm prune --omit=dev


# =========================================================
# STAGE 2: Runner - Môi trường chạy ứng dụng Production tinh gọn
# =========================================================
FROM node:20-alpine AS runner
WORKDIR /app

# Thiết lập biến môi trường chạy thực tế
ENV NODE_ENV=production
ENV PORT=5000

# Copy file package để định hình cấu trúc chạy cho Node
COPY package*.json ./
COPY apps/node-backend/package*.json ./apps/node-backend/

# Bốc thẳng thư mục node_modules đã dọn sạch và sản phẩm sau build từ Stage 1 sang.
# Không chạy lại lệnh cài đặt (npm ci/install) ở đây để tránh làm phình dung lượng image.
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/node-backend/dist ./apps/node-backend/dist
COPY --from=builder /app/apps/node-backend/prisma ./apps/node-backend/prisma

EXPOSE 5000

# Chạy trực tiếp file server.js bằng lệnh node dạng mảng JSON
# Giúp Node.js nhận được các tín hiệu tắt hệ thống để đóng kết nối DB và giải phóng RAM an toàn.
CMD ["node", "apps/node-backend/dist/src/server.js"]