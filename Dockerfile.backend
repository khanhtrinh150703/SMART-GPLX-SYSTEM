# ==========================================
# STAGE 1: Builder - Cài đặt, Biên dịch và Xử lý Alias
# ==========================================
FROM node:20-alpine AS builder
WORKDIR /app

COPY package*.json ./
COPY apps/node-backend/package*.json ./apps/node-backend/
COPY tsconfig*.json ./
COPY apps/node-backend/tsconfig*.json ./apps/node-backend/

RUN npm ci
COPY . .

RUN npm run db:gen -w node-backend
RUN cd apps/node-backend && npm run build

# 🎯 BƯỚC QUYẾT ĐỊNH: Xử lý alias cho toàn bộ thư mục dist (bao gồm cả server lẫn seed nằm trong dist)
RUN npx --yes tsc-alias -p apps/node-backend/tsconfig.json

# ==========================================
# STAGE 2: Runner - Môi trường chạy Production tinh gọn
# ==========================================
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production

COPY package*.json ./
COPY apps/node-backend/package*.json ./apps/node-backend/

RUN npm ci --omit=dev
RUN npm install prisma @prisma/client

COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma ./node_modules/@prisma
COPY --from=builder /app/apps/node-backend/prisma ./apps/node-backend/prisma
COPY --from=builder /app/apps/node-backend/dist ./apps/node-backend/dist

EXPOSE 5000

CMD npx prisma db push --accept-data-loss --schema=apps/node-backend/prisma/schema.prisma && node apps/node-backend/dist/prisma/seed.main.js && node apps/node-backend/dist/src/server.js