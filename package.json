  "scripts": {
    "check:fe": "npm run type-check -w nextjs-frontend",
    "check:be": "npm run type-check -w node-backend",
    "verify": "concurrently \"npm run check:fe\" \"npm run check:be\"",
    "dev:fe": "npm run dev -w nextjs-frontend -- --turbo",
    "dev:be": "npm run dev -w node-backend",
    "dev": "concurrently \"npm run dev:fe\" \"npm run dev:be\"",
    "db:gen": "npm run db:gen -w node-backend",
    "db:format": "npm run db:format -w node-backend",
    "db:reset": "npm run db:reset -w node-backend",
    "db:push": "npm run db:push -w node-backend",
    "db:push:test": "npm run db:push:test -w node-backend",
    "db:push:cicd": "npm run db:push:cicd -w node-backend",
    "db:seed": "npm run db:seed -w node-backend",
    "db:pull": "npm run db:pull -w node-backend",
    "test:be": "npm run test -w node-backend",
    "test:be:cicd": "npm run testcicd -w node-backend",
    "lint:be": "npm run lint -w node-backend",
    "lint:fe": "npm run lint -w nextjs-frontend",
    "see:db:be": "npm run db:see -w node-backend"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "^4.2.2",
    "lightningcss-linux-x64-gnu": "^1.32.0"
